<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A stand-in bundle, not a real application. unikeys' install detection is
     existsSync on the bundle path, so this is all it takes to make the column
     appear. See ../../README.md. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.kiro.desktop</string>
	<key>CFBundleName</key>
	<string>Kiro</string>
</dict>
</plist>
